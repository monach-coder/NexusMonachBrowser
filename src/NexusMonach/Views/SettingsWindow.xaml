<Window x:Class="NexusMonach.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Nexus Monach" Width="960" Height="720" MinWidth="820" MinHeight="600"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="/Assets/nexus-monach.ico" WindowStartupLocation="CenterOwner"
        Style="{StaticResource GlassPopupWindow}">
    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource TextColor}" />
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource NexusButton}">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border" BasedOn="{StaticResource SettingsCard}">
            <Setter Property="Margin" Value="0,0,12,14" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="IsExpanded" Value="True" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Настройки" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="Выберите раздел слева. Изменения применяются ко всем открытым вкладкам."
                       Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="245" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="10" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10">
                <TreeView x:Name="SettingsTree" Background="Transparent"
                          Foreground="{StaticResource TextBrush}" BorderThickness="0"
                          SelectedItemChanged="SettingsTree_SelectedItemChanged">
                    <TreeViewItem Header="Основные">
                        <TreeViewItem x:Name="SearchTreeItem" Header="Поиск и стартовая страница"
                                      Tag="Search" IsSelected="True" />
                        <TreeViewItem Header="Внешний вид" Tag="Appearance" />
                        <TreeViewItem Header="Совместимость и функции" Tag="Compatibility" />
                    </TreeViewItem>
                    <TreeViewItem Header="Защита">
                        <TreeViewItem Header="Приватность" Tag="Privacy" />
                        <TreeViewItem Header="Сеть, прокси и DNS" Tag="Network" />
                        <TreeViewItem Header="Privacy Dock" Tag="Monitor" />
                    </TreeViewItem>
                    <TreeViewItem Header="Данные и доступ">
                        <TreeViewItem Header="Nexus Guardian" Tag="Guardian" />
                        <TreeViewItem Header="Passkeys и Windows Hello" Tag="Passkeys" />
                    </TreeViewItem>
                </TreeView>
            </Border>

            <Grid Grid.Column="2">
                <TextBlock x:Name="SettingsSectionTitle" Text="Поиск и стартовая страница"
                           FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"
                           VerticalAlignment="Top" />

                <ScrollViewer x:Name="SearchSection" Margin="0,46,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Поисковая система по умолчанию"
                                           FontSize="15" FontWeight="SemiBold" />
                                <ComboBox x:Name="SearchEngineCombo" Margin="0,12,0,0"
                                          SelectionChanged="SearchEngineCombo_SelectionChanged" />
                                <TextBlock x:Name="SearchEngineDescriptionText" TextWrapping="Wrap"
                                           Margin="0,8,0,0" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Домашняя страница" FontSize="15" FontWeight="SemiBold" />
                                <TextBox x:Name="HomePageBox" Padding="9,7" Margin="0,12,0,0" />
                                <TextBlock Text="app://newtab открывает встроенную локальную стартовую страницу."
                                           Margin="0,6,0,0" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AppearanceSection" Margin="0,46,0,0" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Цветовая тема" FontSize="15" FontWeight="SemiBold" />
                            <ComboBox x:Name="ThemeModeCombo" Margin="0,12,0,0" />
                            <ComboBox x:Name="ThemeCombo" Margin="0,12,0,0" />
                            <TextBlock Text="Режим меняет всё окружение: в светлом режиме фон светлый, а текст тёмный; в тёмном — наоборот. Цветовая палитра задаёт акцент."
                                       TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <ScrollViewer x:Name="PrivacySection" Margin="0,46,0,0" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Защита от отслеживания" FontSize="15" FontWeight="SemiBold" />
                                <ComboBox x:Name="PrivacyLevelCombo" Margin="0,12,0,0" />
                                <TextBlock Text="Строгий режим блокирует больше сторонних трекеров, но может нарушить отдельные функции сайтов."
                                           TextWrapping="Wrap" Margin="0,7,0,12" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <CheckBox x:Name="DntCheck" Content="Отправлять сигнал Do Not Track" />
                                <CheckBox x:Name="GpcCheck" Content="Отправлять Global Privacy Control" />
                                <CheckBox x:Name="StripParametersCheck"
                                          Content="Удалять рекламные метки из ссылок (utm, fbclid, gclid и другие)" />
                                <CheckBox x:Name="BlockNotificationsCheck"
                                          Content="Блокировать запросы на уведомления" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Локальные данные и память" FontSize="15" FontWeight="SemiBold" />
                                <CheckBox x:Name="KnowledgeGraphCheck" Margin="0,12,0,0"
                                          Content="Строить локальный граф знаний из посещённых страниц" />
                                <CheckBox x:Name="MemorySaverCheck"
                                          Content="Экономить память, приостанавливая неактивные вкладки" />
                                <TextBlock Text="Обычный сеанс удаляется при закрытии. При обновлении ядра Guardian создаёт отдельный зашифрованный снимок вкладок и форм."
                                           TextWrapping="Wrap" Margin="0,9,0,0" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="CompatibilitySection" Margin="0,46,0,0" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Функции WebView2" FontSize="15" FontWeight="SemiBold" />
                                <CheckBox x:Name="ExtensionsCheck" Margin="0,12,0,0"
                                          Content="Разрешить распакованные расширения (требуется перезапуск)" />
                                <CheckBox x:Name="PasswordCheck"
                                          Content="Разрешить WebView2 сохранять и подставлять пароли" />
                                <CheckBox x:Name="AutofillCheck"
                                          Content="Разрешить автозаполнение обычных форм" />
                                <TextBlock Text="F12 и Ctrl+Shift+I открывают стандартные инструменты разработчика Chromium."
                                           TextWrapping="Wrap" Margin="0,9,0,0" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Nexus Voice · женский локальный голос"
                                           FontSize="15" FontWeight="SemiBold" />
                                <ComboBox x:Name="VoiceModeCombo" Margin="0,12,0,0" />
                                <TextBlock Text="Голос" Margin="0,10,0,5" />
                                <ComboBox x:Name="NeuralVoiceCombo" />
                                <TextBlock Text="Закадровый перевод видео" Margin="0,10,0,5" />
                                <ComboBox x:Name="VideoTranslationModeCombo" />
                                <TextBlock Text="Сбалансированный режим накапливает законченные реплики и небольшой запас локальной озвучки."
                                           TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <CheckBox x:Name="VoiceStartupCheck" Margin="0,10,0,0"
                                          Content="Озвучивать запуск браузера" />
                                <CheckBox x:Name="VoiceHandsFreeCheck"
                                          Content="Свободные руки: слушать команды после слова «Нексус»" />
                                <TextBlock x:Name="VoiceEngineStatusText" TextWrapping="Wrap" Margin="0,7,0,0" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Проверка локального голосового движка…" />
                                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Распознавание выполняет Whisper. Озвучивание выполняет локальный голос Silero Kseniya V5; Windows SAPI используется только как резерв. Микрофон не включается в приватных окнах." />
                                <Button Content="Проверить голос" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Click="TestVoice_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="GuardianSection" Margin="0,46,0,0" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Отчёты о сбоях" FontSize="15" FontWeight="SemiBold" />
                                <ComboBox x:Name="CrashReportModeCombo" Margin="0,12,0,0"
                                          SelectionChanged="CrashReportModeCombo_SelectionChanged" />
                                <Button Content="Открыть локальный Центр Guardian"
                                        Style="{StaticResource ActionButton}" HorizontalAlignment="Left"
                                        Margin="0,12,0,2" Click="OpenGuardianCenter_Click" />
                                <TextBlock x:Name="CrashDestinationLabel" Text="Куда отправлять"
                                           Margin="0,14,0,5" />
                                <ComboBox x:Name="CrashReportDestinationCombo"
                                          SelectionChanged="CrashReportDestinationCombo_SelectionChanged" />
                                <StackPanel x:Name="CollectorSettingsPanel">
                                    <TextBlock Text="HTTPS-адрес приёмника отчётов (необязательно)"
                                               Margin="0,12,0,5" />
                                    <TextBox x:Name="CrashReportEndpointBox" Padding="9,7" />
                                </StackPanel>
                                <StackPanel x:Name="GitHubSettingsPanel" Visibility="Collapsed">
                                    <TextBlock Text="Репозиторий GitHub (владелец/имя)" Margin="0,12,0,5" />
                                    <TextBox x:Name="GitHubRepositoryBox" Padding="9,7"
                                             ToolTip="Например: monach-coder/NexusMonachBrowser" />
                                    <TextBlock Text="Access token (fine-grained PAT, только Issues: Read &amp; Write)"
                                               Margin="0,12,0,5" />
                                    <PasswordBox x:Name="GitHubAccessTokenBox" Padding="9,7" />
                                    <TextBlock x:Name="GitHubTokenStatusText" Margin="0,5,0,0"
                                               FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                                    <CheckBox x:Name="DeleteGitHubTokenCheck"
                                              Content="Удалить ранее сохранённый token" />
                                    <Button Content="Проверить GitHub" Style="{StaticResource ActionButton}"
                                            HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Click="TestGitHub_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="В локальном режиме рапорты остаются только на этом компьютере. Guardian удаляет URL, историю, DOM, cookies, токены, введённые данные, IP/DNS и содержимое аудио." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="NetworkSection" Margin="0,46,0,0" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Прокси" FontSize="15" FontWeight="SemiBold" />
                                <CheckBox x:Name="CustomProxyCheck" Margin="0,12,0,0"
                                          Content="Использовать собственный прокси для браузера" />
                                <TextBlock Text="Тип прокси" Margin="0,10,0,5" />
                                <ComboBox x:Name="ProxyTypeCombo" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="IP-адрес или имя сервера" Margin="0,0,0,5" />
                                        <TextBox x:Name="ProxyHostBox" Padding="9,7" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Порт" Margin="0,0,0,5" />
                                        <TextBox x:Name="ProxyPortBox" Padding="9,7" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Сайты с прямым подключением — по одному в строке"
                                           Margin="0,12,0,5" />
                                <TextBox x:Name="ProxyBypassBox" Padding="9,7" MinHeight="68"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap" />
                                <TextBlock Text="Изменения прокси вступают в силу после перезапуска браузера."
                                           TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="DNS и HTTPS" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Защищённый DNS" Margin="0,12,0,5" />
                                <ComboBox x:Name="SecureDnsModeCombo" />
                                <TextBlock Text="Проверенный DoH-провайдер" Margin="0,10,0,5" />
                                <ComboBox x:Name="SecureDnsProviderCombo" />
                                <CheckBox x:Name="HttpsFirstCheck" Margin="0,12,0,0"
                                          Content="HTTPS-first: сначала пробовать защищённый адрес сайта" />
                                <TextBlock Text="Строгий DoH не переходит незаметно на обычный DNS. HTTPS-first никогда не игнорирует ошибку TLS."
                                           TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Tor · Режим След" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="Весь трафик браузера идёт через Tor-сеть. Если на машине активен VPN — Tor маршрутизируется через него, и цензор видит только VPN."
                                           TextWrapping="Wrap" Margin="0,6,0,10" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <CheckBox x:Name="TrailModeCheck" Margin="0,0,0,8"
                                          Content="Включить Режим След (Tor + строгая приватность)" />
                                <TextBlock x:Name="TorStatusLabel" Text="Tor не запущен"
                                           FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,4,0,10" />
                                <Button x:Name="TorStartButton" Content="Запустить Tor"
                                        Style="{StaticResource NexusButton}" Padding="16,7"
                                        HorizontalAlignment="Left" Margin="0,0,0,12"
                                        Click="TorStartButton_Click" />
                                <TextBlock Text="Свои мосты (по одному в строке)" Margin="0,8,0,5" />
                                <TextBox x:Name="TorBridgesBox" Padding="9,7" MinHeight="80"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                         TextWrapping="Wrap"
                                         ToolTip="obfs4 IP:ПОРТ ОТПЕЧАТОК cert=... iat-mode=0" />
                                <TextBlock Text="Публичные мосты блокируют за минуты. Приватный мост на своём VPS ($3/мес) живёт долго."
                                           TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" />
                                <CheckBox x:Name="TorRelayCheck" Margin="0,14,0,6">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Работать мостом Tor — помогать пользователям цензурных сетей. Браузер никогда не становится выходным узлом; для работы извне нужен проброс портов 9101–9102 на роутере." />
                                </CheckBox>
                                <TextBlock x:Name="TorRelayStatusText" FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="MonitorSection" Margin="0,46,0,0" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Локальный монитор приватности"
                                       FontSize="15" FontWeight="SemiBold" />
                            <CheckBox x:Name="PrivacyMonitorCheck" Margin="0,12,0,0"
                                      Content="Показывать нижнюю панель Privacy Dock при запуске браузера" />
                            <CheckBox x:Name="PreventWebRtcLeakCheck"
                                      Content="Запрещать WebRTC обходить прокси и раскрывать другой IP (требуется перезапуск)" />
                            <TextBlock Text="Privacy Dock автоматически обновляется при открытии нового окна и затем каждые пять минут. Диагностика выполняется локально, без фоновых запросов к внешним IP-сервисам."
                                       TextWrapping="Wrap" Margin="0,9,0,0" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <ScrollViewer x:Name="PasskeysSection" Margin="0,46,0,0" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Passkeys и Windows Hello" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Nexus Monach поддерживает вход по Passkey через WebAuthn движка. Отпечаток, лицо и PIN проверяет Windows Hello: браузер и сайт не получают биометрические данные."
                                       TextWrapping="Wrap" Margin="0,10,0,14" FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <WrapPanel>
                                <Button Content="Параметры входа Windows"
                                        Style="{StaticResource ActionButton}" Margin="0,0,8,8"
                                        Click="OpenSignInOptions_Click" />
                                <Button Content="Настроить отпечаток"
                                        Style="{StaticResource ActionButton}" Margin="0,0,8,8"
                                        Click="OpenFingerprintSetup_Click" />
                            </WrapPanel>
                            <TextBlock Text="В Windows 11 доступ отдельных приложений к ключам настраивается в разделе «Конфиденциальность и безопасность → Доступ к ключам доступа»."
                                       TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Отмена" Style="{StaticResource ActionButton}" Click="Cancel_Click" />
            <Button Content="Сохранить" Style="{StaticResource ActionButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
