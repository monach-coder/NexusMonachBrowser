<Window x:Class="NexusMonach.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="clr-namespace:NexusMonach.Controls"
        Width="360" Height="400" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                             From="0.25" To="0.72" Duration="0:0:1.4" />
            <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX"
                             From="0.97" To="1.02" Duration="0:0:1.4" />
            <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY"
                             From="0.97" To="1.02" Duration="0:0:1.4" />
        </Storyboard>
    </Window.Resources>
    <Grid Loaded="Grid_Loaded">
        <Ellipse x:Name="Glow" Width="322" Height="322" Fill="#5036D7C4" />
        <Ellipse Width="294" Height="294" Fill="#D90B1018" Stroke="#5536D7C4" StrokeThickness="2" />
        <!-- Кольцо, разделённое на секторы — по одному на процесс старта:
             целостность → обновление → загрузка → запуск. В активном секторе
             бежит полоса заполнения; завершённые мягко подсвечены. -->
        <Path x:Name="Track0" Stroke="#2D2634" StrokeThickness="6" StrokeDashCap="Round" />
        <Path x:Name="Track1" Stroke="#2D2634" StrokeThickness="6" StrokeDashCap="Round" />
        <Path x:Name="Track2" Stroke="#2D2634" StrokeThickness="6" StrokeDashCap="Round" />
        <Path x:Name="Track3" Stroke="#2D2634" StrokeThickness="6" StrokeDashCap="Round" />
        <Path x:Name="Fill0" Stroke="#36D7C4" StrokeThickness="6" StrokeDashCap="Round" />
        <Path x:Name="Fill1" Stroke="#36D7C4" StrokeThickness="6" StrokeDashCap="Round" />
        <Path x:Name="Fill2" Stroke="#36D7C4" StrokeThickness="6" StrokeDashCap="Round" />
        <Path x:Name="Fill3" Stroke="#36D7C4" StrokeThickness="6" StrokeDashCap="Round" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Controls:CyberGlobe x:Name="Globe" Width="150" Height="150" />
            <TextBlock Text="NEXUS MONACH" Margin="0,14,0,0" Foreground="#EEF4F8"
                       FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <!-- Статус Guardian: целостность + обновление, дышит вместе с глобусом. -->
            <TextBlock x:Name="StatusText" Text="Guardian проверяет целостность…" Margin="0,6,0,0"
                       Foreground="#91A2B4" FontSize="11" HorizontalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="300" />
            <TextBlock x:Name="DetailText" Text="" Margin="0,3,0,0"
                       Foreground="#DAB96A" FontSize="10" HorizontalAlignment="Center" />
            <TextBlock x:Name="StagesText" Text="" Margin="0,5,0,0"
                       Foreground="#6E7E92" FontSize="9" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
