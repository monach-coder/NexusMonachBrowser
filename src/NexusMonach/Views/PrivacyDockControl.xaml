<UserControl x:Class="NexusMonach.Views.PrivacyDockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ChromeBrush}" Loaded="Control_Loaded" Unloaded="Control_Unloaded">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
        <StackPanel>

            <!-- Заголовок и статус цепочки -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                    <Run Text="ПРИВАТНОСТЬ И ЗАЩИТА" Foreground="{StaticResource GoldBrush}" />
                    <Run x:Name="ChainStatusText" Text="Маршрут: прямой" Foreground="{StaticResource AccentBrush}" />
                </TextBlock>
                <Button x:Name="CollapseButton" Grid.Column="2" Content="Свернуть" FontSize="10.5"
                        Style="{StaticResource IconButton}" Padding="8,3"
                        ToolTip="Свернуть панель (вернуть — галочка в настройках или меню)"
                        Click="Collapse_Click" />
            </Grid>

            <!-- Тумблеры сетевой цепочки -->
            <UniformGrid Columns="3" Margin="0,8,0,0">
                <Button x:Name="VlessToggle" Margin="0,0,8,0" Padding="10,7" FontSize="12"
                        Style="{StaticResource IconButton}" Click="VlessToggle_Click"
                        Content="Сервер: выкл" ToolTip="Направить трафик через собственный сервер" />
                <Button x:Name="TorToggle" Margin="0,0,8,0" Padding="10,7" FontSize="12"
                        Style="{StaticResource IconButton}" Click="TorToggle_Click"
                        Content="Маршрут: вне цепочки" ToolTip="Слой анонимности в цепочке вкладок" />
                <Button x:Name="ProxyToggle" Padding="10,7" FontSize="12"
                        Style="{StaticResource IconButton}" Click="ProxyToggle_Click"
                        Content="Прокси: выкл" ToolTip="Ручной прокси из настроек сети" />
            </UniformGrid>

            <!-- Ссылка сервера и конфигурация прокси -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VlessUriBox" Padding="8,5" FontSize="11.5" VerticalContentAlignment="Center"
                         ToolTip="Ссылка профиля сервера (vless://…)" />
                <Button x:Name="VlessConnectButton" Grid.Column="1" Content="Подключить" Margin="8,0,0,0"
                        Padding="10,5" FontSize="11.5" Style="{StaticResource IconButton}"
                        Click="VlessConnect_Click" />
                <TextBox x:Name="ProxyHostBox" Grid.Column="2" Margin="8,0,0,0" Padding="8,5" FontSize="11.5"
                         VerticalContentAlignment="Center" ToolTip="Прокси: адрес или имя сервера" />
                <TextBox x:Name="ProxyPortBox" Grid.Column="3" Margin="6,0,0,0" Padding="8,5" FontSize="11.5"
                         VerticalContentAlignment="Center" ToolTip="Прокси: порт" />
                <ComboBox x:Name="ProxyKindCombo" Grid.Column="4" Margin="6,0,0,0" Width="82" FontSize="11.5"
                          VerticalAlignment="Center" ToolTip="Тип прокси" />
            </Grid>

            <!-- Защита -->
            <WrapPanel Margin="0,9,0,0">
                <CheckBox x:Name="TrailModeCheck" Margin="0,0,14,4" FontSize="11.5"
                          Content="Режим Следа" Checked="TrailMode_Changed" Unchecked="TrailMode_Changed"
                          ToolTip="Строгая приватность + анонимный маршрут" />
                <CheckBox x:Name="WatchdogCheck" Margin="0,0,14,4" FontSize="11.5"
                          Content="Сетевой Дозор" Checked="Watchdog_Changed" Unchecked="Watchdog_Changed"
                          ToolTip="Ловушки, обман сканеров, стражи ARP/DNS (применяется после перезапуска)" />
                <CheckBox x:Name="RelayCheck" Margin="0,0,14,4" FontSize="11.5"
                          Content="Релейный мост" Checked="Relay_Changed" Unchecked="Relay_Changed"
                          ToolTip="Помогать пользователям цензурных сетей; выходным узлом браузер не бывает" />
                <CheckBox x:Name="WebRtcLeakCheck" Margin="0,0,14,4" FontSize="11.5"
                          Content="Страж WebRTC" Checked="WebRtc_Changed" Unchecked="WebRtc_Changed"
                          ToolTip="Запретить WebRTC обходить прокси (применяется после перезапуска)" />
                <ComboBox x:Name="PortShieldCombo" Width="230" FontSize="11" VerticalAlignment="Center"
                          SelectionChanged="PortShield_Changed"
                          ToolTip="Порт-щит: закрытие утекающих портов локальной сети на сессию" />
            </WrapPanel>

        </StackPanel>
    </Border>
</UserControl>
