<UserControl x:Class="NexusMonach.Views.PrivacyDockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ChromeBrush}" Loaded="Control_Loaded" Unloaded="Control_Unloaded">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
        <StackPanel>

            <!-- Заголовок и статус цепочки -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                    <Run Text="ПРИВАТНОСТЬ И ЗАЩИТА" Foreground="{StaticResource GoldBrush}" />
                    <Run x:Name="ChainStatusText" Text="Маршрут: прямой" Foreground="{StaticResource AccentBrush}" />
                </TextBlock>
                <Button x:Name="CollapseButton" Grid.Column="2" Content="Свернуть" FontSize="10.5"
                        Style="{StaticResource NexusButton}" Padding="8,3"
                        ToolTip="Свернуть панель (вернуть — галочка в настройках сети)"
                        Click="Collapse_Click" />
            </Grid>

            <!-- Смысловой блок 1: куда идёт трафик -->
            <TextBlock Text="СЕТЕВАЯ ЦЕПОЧКА" FontSize="9.5" Margin="0,8,0,4"
                       Foreground="{StaticResource MutedTextBrush}" />
            <UniformGrid Columns="3">
                <Button x:Name="VlessToggle" Margin="0,0,8,0" Padding="10,7" FontSize="12"
                        Style="{StaticResource NexusButton}" Click="VlessToggle_Click"
                        Content="Сервер: выкл" ToolTip="Направить трафик через собственный сервер" />
                <Button x:Name="TorToggle" Margin="0,0,8,0" Padding="10,7" FontSize="12"
                        Style="{StaticResource NexusButton}" Click="TorToggle_Click"
                        Content="Маршрут: вне цепочки" ToolTip="Слой анонимности в цепочке вкладок" />
                <Button x:Name="ProxyToggle" Padding="10,7" FontSize="12"
                        Style="{StaticResource NexusButton}" Click="ProxyToggle_Click"
                        Content="Прокси: выкл" ToolTip="Ручной прокси из настроек сети" />
            </UniformGrid>

            <!-- Настройка сервера и прокси: поля с смысловой подписью-разделителем -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="VlessUriBox" Padding="8,5" FontSize="11.5" VerticalContentAlignment="Center"
                         ToolTip="Ссылка профиля сервера (vless://…)" />
                <Button x:Name="VlessConnectButton" Grid.Column="1" Content="Подключить" Margin="8,0,0,0"
                        Padding="10,5" FontSize="11.5" Style="{StaticResource NexusButton}"
                        Click="VlessConnect_Click" />
                <TextBlock Grid.Column="2" Text="прокси ·" FontSize="9.5" Margin="14,0,6,0"
                           VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBox x:Name="ProxyHostBox" Grid.Column="3" Padding="8,5" FontSize="11.5"
                         VerticalContentAlignment="Center" ToolTip="Прокси: адрес или имя сервера" />
                <TextBox x:Name="ProxyPortBox" Grid.Column="4" Margin="6,0,0,0" Padding="8,5" FontSize="11.5"
                         VerticalContentAlignment="Center" ToolTip="Прокси: порт" />
                <ComboBox x:Name="ProxyKindCombo" Grid.Column="5" Margin="6,0,0,0" Width="82" FontSize="11.5"
                          VerticalAlignment="Center" DisplayMemberPath="Label" ToolTip="Тип прокси" />
            </Grid>

            <!-- Мосты против DPI: obfs4 и webtunnel, по одному в строке.
                 webtunnel-мосты живучее в цензурных сетях (маскируются под HTTPS). -->
            <Expander Margin="0,8,0,0" FontSize="10.5" Header="Мосты против DPI (obfs4 / webtunnel)">
                <StackPanel>
                    <Button Content="Получить приватные webtunnel-мосты…" Margin="0,6,0,6" Padding="9,5"
                            FontSize="10.5" Style="{StaticResource NexusButton}"
                            Click="FetchBridges_Click"
                            ToolTip="Запрос к официальному разда́тчику Tor Project: решаете капчу — браузер получает неизданные мосты и сам вписывает их в пул" />
                    <TextBox x:Name="BridgesBox" Padding="7,5" FontSize="11" MinHeight="52" Margin="0,0,0,4"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             ToolTip="Ручные мосты (важнее пула):&#10;obfs4 IP:ПОРТ ОТПЕЧАТОК cert=... iat-mode=0&#10;webtunnel IP:ПОРТ ОТПЕЧАТОК url=https://сайт/путь cert=...&#10;Бинарные транспорты кладутся в C:\Tor\pluggable_transports (lyrebird.exe, webtunnel-client.exe)"
                             LostFocus="BridgesBox_LostFocus" />
                    <TextBlock Text="Пул приватных мостов (по одному в строке) — каждая сессия берёт случайный:"
                               FontSize="9.5" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <TextBox x:Name="BridgePoolBox" Padding="7,5" FontSize="11" MinHeight="44" Margin="0,4,0,4"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             ToolTip="Свои приватные webtunnel/obfs4-мосты. Ротация криптослучайная, новой сессии — новый мост"
                             LostFocus="BridgePoolBox_LostFocus" />
                    <TextBlock FontSize="9.5" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                               Text="Применяется при следующем запуске маршрута. Публичные мосты блокируют быстро; приватный мост на своём сервере живёт долго." />
                </StackPanel>
            </Expander>

            <!-- Смысловой блок 2: защита самой машины -->
            <TextBlock Text="ЗАЩИТА МАШИНЫ" FontSize="9.5" Margin="0,10,0,4"
                       Foreground="{StaticResource MutedTextBrush}" />
            <WrapPanel>
                <CheckBox x:Name="TrailModeCheck" Margin="0,0,14,4" FontSize="11.5"
                          Content="Режим Следа" Checked="TrailMode_Changed" Unchecked="TrailMode_Changed"
                          ToolTip="Строгая приватность + анонимный маршрут" />
                <CheckBox x:Name="WatchdogCheck" Margin="0,0,14,4" FontSize="11.5"
                          Content="Сетевой Дозор" Checked="Watchdog_Changed" Unchecked="Watchdog_Changed"
                          ToolTip="Ловушки, обман сканеров, стражи ARP/DNS (применяется после перезапуска)" />
                <CheckBox x:Name="RelayCheck" Margin="0,0,14,4" FontSize="11.5"
                          Content="Релейный мост" Checked="Relay_Changed" Unchecked="Relay_Changed"
                          ToolTip="Помогать пользователям цензурных сетей; выходным узлом браузер не бывает" />
                <CheckBox x:Name="WebRtcLeakCheck" Margin="0,0,14,4" FontSize="11.5"
                          Content="Страж WebRTC" Checked="WebRtc_Changed" Unchecked="WebRtc_Changed"
                          ToolTip="Запретить WebRTC обходить прокси (применяется после перезапуска)" />
                <ComboBox x:Name="PortShieldCombo" Width="230" FontSize="11" VerticalAlignment="Center"
                          DisplayMemberPath="Label" SelectionChanged="PortShield_Changed"
                          ToolTip="Порт-щит: закрытие утекающих портов локальной сети на сессию" />
            </WrapPanel>

        </StackPanel>
    </Border>
</UserControl>
