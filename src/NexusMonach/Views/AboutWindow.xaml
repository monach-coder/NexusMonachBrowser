<Window x:Class="NexusMonach.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="О Nexus Monach" Width="540" Height="640" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="/Assets/nexus-monach.ico" WindowStartupLocation="CenterOwner" Style="{StaticResource GlassPopupWindow}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center">
            <Image Width="112" Height="112" Source="/Assets/nexus-monach-512.png" />
            <TextBlock Text="NEXUS MONACH" Margin="0,12,0,0" FontSize="25" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionText" Margin="0,4,0,0"
                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock TextWrapping="Wrap" TextAlignment="Center"
                       Text="Лёгкий приватный браузер без собственной телеметрии. Локальная сетевая диагностика без IP-сервисов, Smart Capsules, Knowledge Constellation и автономные модели для перевода, поиска и анализа." />
            <Border Margin="0,16,0,0" Padding="14,10" Background="{StaticResource SelectedBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="АВТОРЫ ПРОЕКТА" HorizontalAlignment="Center"
                               Foreground="{StaticResource GoldBrush}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="CoderMonach  ×  OpenAI Codex  ×  ZCode" Margin="0,4,0,0"
                               HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Идея, видение и направление — CoderMonach. Проектирование и код — в сотрудничестве с OpenAI Codex и ZCode (агент на модели GLM, Z.ai): надёжность запуска, локальный нейроголос и словарь ударений."
                               Margin="0,5,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Margin="0,10,0,0" Padding="12,9" Background="{StaticResource PanelBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="NEXUS INTELLIGENCE FABRIC™" Foreground="{StaticResource GoldBrush}"
                               FontSize="10" FontWeight="SemiBold" />
                    <TextBlock Text="Открытый локальный исследовательский слой" Margin="0,3,0,0"
                               Foreground="{StaticResource AccentBrush}" FontSize="10.5" />
                    <TextBlock x:Name="FabricStatusText" Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                </StackPanel>
            </Border>
            <Border Margin="0,18,0,0" Padding="14" Background="{StaticResource PanelBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                           Text="Честное ограничение: никакой обычный браузер не может одновременно гарантировать полную анонимность и стопроцентную совместимость. Nexus Monach уменьшает отслеживание через cookies, сетевые трекеры, рекламные параметры и сигналы приватности, но не скрывает IP-адрес. Для этого нужен доверенный туннель или анонимный маршрут." />
            </Border>
        </StackPanel>
    </Grid>
</Window>
