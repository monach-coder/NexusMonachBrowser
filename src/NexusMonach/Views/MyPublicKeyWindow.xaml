<Window x:Class="NexusMonach.Views.MyPublicKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мой ключ — защищённый обмен" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="/Assets/nexus-monach.ico" Style="{StaticResource GlassPopupWindow}">
    <StackPanel Margin="18">
        <TextBlock Text="Это твой публичный ключ — личность браузера в защищённом обмене. Он не секрет: передай его собеседнику любым каналом (чат, почта, продиктуй). Подделать содержание под ним нельзя — важна лишь неприкосновенность самого ключа."
                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock Text="Отпечаток (сверьтесь голосом или при встрече):" Margin="0,12,0,4"
                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock x:Name="FingerprintText" FontFamily="Cascadia Mono, Consolas" FontSize="18"
                   FontWeight="SemiBold" Foreground="#36D7C4" HorizontalAlignment="Center" />
        <TextBlock Text="Полный ключ (base64):" Margin="0,12,0,4" FontSize="11"
                   Foreground="{StaticResource MutedTextBrush}" />
        <TextBox x:Name="KeyText" Padding="9,7" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                 TextWrapping="Wrap" MinHeight="86" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Проговорить отпечаток" Style="{StaticResource NexusButton}" Padding="12,7"
                    Margin="0,0,10,0" Click="SpeakFingerprint_Click" />
            <Button Content="Скопировать ключ" Style="{StaticResource NexusButton}" Padding="12,7"
                    Margin="0,0,10,0" Click="CopyKey_Click" />
            <Button Content="Готово" Style="{StaticResource NexusButton}" Padding="14,7"
                    IsDefault="True" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
