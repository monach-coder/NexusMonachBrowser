<UserControl x:Class="NexusMonach.Views.PlannerDockControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="330" Background="{StaticResource ChromeBrush}"
             Loaded="Control_Loaded" Unloaded="Control_Unloaded">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Заголовок + сворачивание -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                    <Run Text="ПЛАНИРОВЩИК" Foreground="{StaticResource GoldBrush}" />
                    <Run x:Name="StatusRun" Text="· задачи" Foreground="{StaticResource AccentBrush}" />
                </TextBlock>
                <Button x:Name="CollapseButton" Grid.Column="1" Content="◀" FontSize="11"
                        Style="{StaticResource NexusButton}" Padding="8,3"
                        ToolTip="Свернуть панель (вернуть — кнопка «План» на панели браузера)"
                        Click="Collapse_Click" />
            </Grid>

            <!-- Вкладки -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,6">
                <RadioButton x:Name="TasksTab" GroupName="PlannerTab" Content="Задачи" FontSize="12"
                             IsChecked="True" Checked="TasksTab_Checked" Margin="0,0,14,0" />
                <RadioButton x:Name="ChatTab" GroupName="PlannerTab" Content="Защищённый обмен" FontSize="12"
                             Checked="ChatTab_Checked" />
            </StackPanel>

            <!-- ── Вкладка задач ── -->
            <Grid x:Name="TasksPane" Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewTaskBox" Padding="7,5" FontSize="11.5" KeyDown="NewTaskBox_KeyDown"
                             ToolTip="Название задачи; Enter — добавить" />
                    <Button Grid.Column="1" Content="+" Margin="6,0,0,0" Padding="10,4" FontSize="12"
                            Style="{StaticResource NexusButton}" Click="AddTask_Click" ToolTip="Добавить задачу" />
                    <Button Grid.Column="2" Content="🗓" Margin="6,0,0,0" Padding="10,4" FontSize="12"
                            Style="{StaticResource NexusButton}" Click="ExportIcs_Click"
                            ToolTip="Экспорт задач со сроками в календарь (.ics)" />
                </Grid>
                <ListBox x:Name="TasksList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,4,6" Padding="9" CornerRadius="8"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Done, Mode=TwoWay}"
                                                  Content="{Binding Title}" FontSize="11.5"
                                                  Checked="TaskToggle_Changed" Unchecked="TaskToggle_Changed" />
                                        <Button Grid.Column="1" Content="✉" Margin="6,0,0,0" Padding="6,3" FontSize="10"
                                                Style="{StaticResource NexusButton}" Click="MailTask_Click"
                                                ToolTip="Отправить по почте" />
                                        <Button Grid.Column="2" Content="✕" Margin="4,0,0,0" Padding="6,3" FontSize="10"
                                                Style="{StaticResource NexusButton}" Click="RemoveTask_Click"
                                                ToolTip="Удалить задачу" />
                                    </Grid>
                                    <TextBlock Text="{Binding Meta}" FontSize="9.5" Margin="18,2,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="TasksSummary" Grid.Row="2" FontSize="10" Margin="0,6,0,0"
                           Foreground="{StaticResource MutedTextBrush}" />
            </Grid>

            <!-- ── Вкладка обмена ── -->
            <Grid x:Name="ChatPane" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,6">
                    <TextBox x:Name="DisplayNameBox" Width="120" Padding="7,5" FontSize="11.5"
                             ToolTip="Ваше имя для участников обмена" />
                    <Button Content="Создать комнату" Margin="6,0,0,0" Padding="9,4" FontSize="11"
                            Style="{StaticResource NexusButton}" Click="CreateRoom_Click" />
                    <Button Content="Инвайт…" Margin="6,0,0,0" Padding="9,4" FontSize="11"
                            Style="{StaticResource NexusButton}" Click="MakeInvite_Click"
                            ToolTip="Пригласить: файл-инвайт для собеседника" />
                    <Button Content="Войти по инвайту" Margin="6,0,0,0" Padding="9,4" FontSize="11"
                            Style="{StaticResource NexusButton}" Click="JoinByInvite_Click" />
                </WrapPanel>
                <ListBox x:Name="ChatList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,4,5" Padding="8" CornerRadius="8"
                                    Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Line}" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Meta}" FontSize="9" Margin="0,2,0,0"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="📎" Padding="8,4" FontSize="11" Style="{StaticResource NexusButton}"
                            Click="AttachFile_Click" ToolTip="Прикрепить файл или скрин вкладки" />
                    <TextBox x:Name="MessageBox" Grid.Column="1" Margin="6,0,0,0" Padding="7,5" FontSize="11.5"
                             KeyDown="MessageBox_KeyDown"
                             ToolTip="Сообщение; маркеры: «задача: …», «факт: …», «решение: …» уходят в память" />
                    <Button Grid.Column="2" Content="➤" Margin="6,0,0,0" Padding="10,4" FontSize="11"
                            Style="{StaticResource NexusButton}" Click="SendMessage_Click" />
                </Grid>
            </Grid>

            <TextBlock x:Name="ChatState" Grid.Row="3" FontSize="9.5" Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                       Text="Обмен живёт, пока хоть один участник онлайн; переписка испаряется — остаются только знания." />
        </Grid>
    </Border>
</UserControl>
