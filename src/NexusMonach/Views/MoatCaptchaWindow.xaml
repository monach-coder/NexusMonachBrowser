<Window x:Class="NexusMonach.Views.MoatCaptchaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Приватные мосты Tor Project" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="/Assets/nexus-monach.ico" Style="{StaticResource GlassPopupWindow}">
    <StackPanel Margin="18">
        <TextBlock Text="Решите задание — и браузер получит неизданные webtunnel-мосты прямо от разда́тчика Tor Project, впишет их в пул и начнёт ротацию по сессиям. Публичные списки не используются."
                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
        <Image x:Name="CaptchaImage" Margin="0,12,0,10" MaxWidth="340" HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <TextBox x:Name="SolutionBox" Padding="9,7" FontSize="14" MaxLength="24" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Style="{StaticResource NexusButton}" Padding="14,7" Margin="0,0,10,0"
                    IsCancel="True" />
            <Button Content="Получить мосты" Style="{StaticResource NexusButton}" Padding="14,7"
                    IsDefault="True" Click="Accept_Click" />
        </StackPanel>
    </StackPanel>
</Window>
