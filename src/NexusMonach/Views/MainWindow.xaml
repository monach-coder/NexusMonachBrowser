<Window x:Class="NexusMonach.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:NexusMonach.Views"
        xmlns:models="clr-namespace:NexusMonach.Models"
        xmlns:services="clr-namespace:NexusMonach.Services"
        Title="Nexus Monach"
        Width="1280" Height="880" MinWidth="900" MinHeight="650"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        Icon="/Assets/nexus-monach.ico"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="12"
                            GlassFrameThickness="1"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="MainSurface" Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="54" />
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
            <RowDefinition Height="54" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Собственная верхняя панель без системных чёрных полос. -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{StaticResource ChromeBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="38" />
                <ColumnDefinition Width="38" />
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style x:Key="TitleButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButton}">
                    <Setter Property="Width" Value="34" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="5" />
                    <Setter Property="FontSize" Value="11" />
                </Style>
            </Grid.Resources>

            <Image Grid.Column="0" Width="28" Height="28" Source="/Assets/nexus-monach-512.png"
                   ToolTip="Nexus Monach" />

            <ListBox x:Name="TabsList" Grid.Column="1"
                     ItemsSource="{Binding Tabs}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="TabsList_PreviewMouseLeftButtonDown"
                     ToolTip="Левый клик по свободному месту справа от вкладок создаёт новую"
                     SelectionChanged="TabsList_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="1,4,1,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="TabBorder" Width="190" Height="38"
                                            Background="{StaticResource PanelBrush}" CornerRadius="9,9,0,0"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,1,0">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SelectedBrush}" />
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,0,4,0" Opacity="{Binding VisualOpacity}"
                              ToolTip="Неактивные вкладки постепенно затухают и выгружаются из памяти">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ShortTitle}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       FontFamily="Segoe UI" FontSize="12.5" />
                            <Button Grid.Column="1" Content="×" Tag="{Binding}"
                                    Style="{StaticResource IconButton}" FontFamily="Segoe UI"
                                    FontSize="18" Padding="2" ToolTip="Закрыть вкладку"
                                    Click="CloseTab_Click" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border x:Name="PrivateBadge" Grid.Column="2" Margin="5,8,0,5" Padding="10,0"
                    CornerRadius="12" Background="#2C1D46" BorderBrush="#7653A6" BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock Text="ПРИВАТНО" FontSize="10" FontWeight="SemiBold"
                           Foreground="#D7C0FF" VerticalAlignment="Center" />
            </Border>

            <Border x:Name="DownloadsIndicator" Grid.Column="3" Margin="6,8,8,5" Padding="9,0"
                    MinWidth="64" CornerRadius="12" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" Cursor="Hand"
                    Visibility="Collapsed" ToolTip="Загрузки — наведите, чтобы открыть список"
                    MouseEnter="DownloadsIndicator_MouseEnter" MouseLeave="DownloadsIndicator_MouseLeave">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="DownloadsIndicatorGlyph" Text="&#xE896;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                               Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="DownloadsIndicatorText" Text="0%" Margin="7,0,0,0"
                               FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Button Grid.Column="4" Content="&#xE921;" Style="{StaticResource TitleButtonStyle}"
                    ToolTip="Свернуть" Click="Minimize_Click" />
            <Button x:Name="MaximizeButton" Grid.Column="5" Content="&#xE922;"
                    Style="{StaticResource TitleButtonStyle}" ToolTip="Развернуть"
                    Click="Maximize_Click" />
            <Button Grid.Column="6" Content="&#xE72C;" Style="{StaticResource TitleButtonStyle}"
                    Foreground="{StaticResource AccentBrush}" ToolTip="Перезапустить Nexus Monach"
                    Click="RestartWindow_Click" />
        </Grid>

        <Grid Grid.Row="1" Background="{StaticResource ToolbarBrush}" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Content="&#xE72B;"
                    Style="{StaticResource IconButton}" ToolTip="Назад (Alt+←)" Click="Back_Click" />
            <Button x:Name="ForwardButton" Grid.Column="1" Content="&#xE72A;"
                    Style="{StaticResource IconButton}" ToolTip="Вперёд (Alt+→)" Click="Forward_Click" />
            <Button x:Name="ReloadButton" Grid.Column="2" Content="&#xE72C;"
                    Style="{StaticResource IconButton}" ToolTip="Обновить / остановить (F5)" Click="Reload_Click" />
            <Button Grid.Column="3" Content="&#xE80F;"
                    Style="{StaticResource IconButton}" ToolTip="Домой" Click="Home_Click" />

            <Border x:Name="AddressBorder" Grid.Column="4" Margin="5,8" CornerRadius="18"
                    Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ConnectionGlyph" Grid.Column="0" Text="&#xE72E;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                               HorizontalAlignment="Center" ToolTip="Сведения о соединении" />
                    <TextBox x:Name="AddressBox" Grid.Column="1" BorderThickness="0" Background="Transparent"
                             Padding="2,7" VerticalContentAlignment="Center"
                             KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotKeyboardFocus" />
                    <Button Grid.Column="2" Content="&#xE721;" Style="{StaticResource IconButton}"
                            Padding="3" ToolTip="Перейти / искать" Click="SearchButton_Click" />
                </Grid>
            </Border>

            <Button x:Name="BookmarkButton" Grid.Column="5" Content="&#xE734;"
                    Style="{StaticResource IconButton}" ToolTip="Добавить в закладки (Ctrl+D)"
                    Click="Bookmark_Click" />

            <Button Grid.Column="6" Content="RU" Style="{StaticResource IconButton}" FontFamily="Segoe UI"
                    FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}"
                    ToolTip="Озвучить статью, перевести интерфейс или звук видео" Click="TranslateMenu_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Озвучить статью и перевести интерфейс" Click="TranslateTop_Click" />
                        <MenuItem Header="Закадровый перевод видео на русский" Click="TranslateVideoAudio_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button Grid.Column="7" Content="AI" Style="{StaticResource IconButton}" FontFamily="Segoe UI"
                    FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                    ToolTip="Nexus Следопыт: найти, проверить и сравнить информацию" Click="ShoppingAgentTop_Click" />

            <Button Grid.Column="8" Content="&gt;_" Style="{StaticResource IconButton}"
                    FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="SemiBold"
                    Foreground="{StaticResource AccentBrush}" ToolTip="SSH-терминал Linux"
                    Click="SshTerminal_Click" />

            <Button x:Name="VoiceButton" Grid.Column="9" Content="&#xE720;"
                    Style="{StaticResource IconButton}" Foreground="{StaticResource AccentBrush}"
                    ToolTip="Nexus Voice: нажмите и говорите" Click="VoiceButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Сказать команду" Click="VoiceListenMenu_Click" />
                        <MenuItem Header="Остановить голос" Click="VoiceStopMenu_Click" />
                        <Separator />
                        <MenuItem x:Name="HandsFreeMenuItem" Header="Свободные руки · слово «Нексус»"
                                  IsCheckable="True" Click="HandsFreeMenuItem_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Button x:Name="MenuButton" Grid.Column="10" Content="&#xE712;"
                    Style="{StaticResource IconButton}" ToolTip="Меню" Click="MenuButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Новая вкладка" InputGestureText="Ctrl+T" Click="NewTab_Click" />
                        <MenuItem Header="Новое приватное окно" InputGestureText="Ctrl+Shift+N" Click="NewPrivateWindow_Click" />
                        <Separator />
                        <MenuItem Header="Закладки" InputGestureText="Ctrl+Shift+B" Click="ShowBookmarks_Click" />
                        <MenuItem Header="Загрузки" InputGestureText="Ctrl+J" Click="ShowDownloads_Click" />
                        <MenuItem Header="Умные капсулы вкладок" InputGestureText="Ctrl+Shift+K" Click="ShowSmartCapsules_Click" />
                        <MenuItem Header="Граф знаний и память просмотра" InputGestureText="Ctrl+Shift+G" Click="ShowKnowledgeGraph_Click" />
                        <Separator />
                        <MenuItem x:Name="ExtensionsMenuItem" Header="Расширения" Click="ShowExtensions_Click" />
                        <MenuItem Header="Показать / скрыть Privacy Dock" Click="ShowPrivacyMonitor_Click" />
                        <MenuItem Header="Инструменты разработчика Chromium" InputGestureText="F12 / Ctrl+Shift+I"
                                  Click="ShowDeveloperTools_Click" />
                        <MenuItem Header="SSH-терминал Linux" Click="SshTerminal_Click" />
                        <MenuItem Header="Nexus Guardian · локальные рапорты" Click="ShowGuardianCenter_Click" />
                        <MenuItem Header="Настройки" Click="ShowSettings_Click" />
                        <Separator />
                        <MenuItem Header="О браузере" Click="About_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <ProgressBar x:Name="LoadingBar" Grid.Row="2" Height="2" IsIndeterminate="True"
                     Foreground="{StaticResource AccentBrush}" Background="{StaticResource BorderBrush}"
                     Visibility="Collapsed" />

        <Grid Grid.Row="3" Background="{StaticResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="BrowserHost" Grid.Column="0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
            <Border x:Name="TabLoadingOverlay" Grid.Column="0" Background="{StaticResource BackgroundBrush}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Width="82" Height="82" Source="/Assets/nexus-monach-512.png" />
                    <TextBlock Text="Загрузка вкладки…" Margin="0,16,0,0"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                </StackPanel>
            </Border>
            <views:LocalAiDockControl x:Name="LocalAiDock" Grid.Column="1" Visibility="Collapsed"
                                      HorizontalAlignment="Right" VerticalAlignment="Stretch" />
            <views:SshTerminalDockControl x:Name="SshTerminalDock" Grid.Column="1" Visibility="Collapsed"
                                          HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                          CloseRequested="SshTerminal_CloseRequested" />
            <Border x:Name="VoiceStatusBadge" Grid.Column="0" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                    Padding="16,8" CornerRadius="18" Background="{StaticResource OverlayBrush}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Panel.ZIndex="20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE720;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="VoiceStatusText" Text="Слушаю…" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="8,3">
            <Border.Resources>
                <Style x:Key="TopologyNodeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                    <Setter Property="Padding" Value="5,2" />
                    <Setter Property="FontFamily" Value="Segoe UI" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="ToolTip" Value="Нажмите для расширенных сведений" />
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource TopologyNodeButton}" Click="BrowserNode_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Width="25" Height="25" Source="/Assets/nexus-monach-512.png" />
                        <TextBlock Text="NEXUS" Margin="5,0,0,0" VerticalAlignment="Center"
                                   FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="1" Height="2" Margin="6,0" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />

                <Button Grid.Column="2" Style="{StaticResource TopologyNodeButton}" Click="SystemRouteNode_Click">
                    <StackPanel>
                        <TextBlock Text="СИСТЕМНЫЙ МАРШРУТ" FontSize="7.8" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="Windows / VPN" FontSize="9.5" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="3" Height="2" Margin="6,0" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />

                <Button Grid.Column="4" Style="{StaticResource TopologyNodeButton}" Click="LocalPortsNode_Click">
                    <StackPanel>
                        <TextBlock Text="МОИ ПОРТЫ" FontSize="7.8" Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TopologyLocalPortsText" Text="TCP — · UDP —" FontSize="9.5"
                                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="5" Height="2" Margin="6,0" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />

                <Button Grid.Column="6" Style="{StaticResource TopologyNodeButton}" Click="RoutingNode_Click">
                    <StackPanel>
                        <TextBlock Text="МАРШРУТИЗАЦИЯ" FontSize="7.8" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="TopologyProxyText" Text="Прямое подключение" FontSize="9.5" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="7" Margin="8,4" Padding="8,3" Background="{StaticResource FieldBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7"
                        VerticalAlignment="Center"
                        ToolTip="Текущая скорость активного сетевого адаптера и локальная проверка шлюза Windows">
                    <StackPanel>
                        <TextBlock x:Name="TopologyRateText" Text="↓ — · ↑ —"
                                   FontSize="8.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="TopologyPingText" Text="PING —" Margin="0,2,0,0"
                                   FontSize="8" HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>

                <Button Grid.Column="8" Style="{StaticResource TopologyNodeButton}" Click="InternetNode_Click">
                    <StackPanel>
                        <TextBlock Text="ИНТЕРНЕТ" FontSize="7.8" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="TLS / WebView2" FontSize="9.5" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Grid.Column="9" Height="2" Margin="6,0" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />

                <Button Grid.Column="10" Style="{StaticResource TopologyNodeButton}" Click="CurrentSiteNode_Click" MaxWidth="220">
                    <StackPanel>
                        <TextBlock Text="ТЕКУЩИЙ САЙТ" FontSize="7.8" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TopologySiteText" Text="Новая вкладка" FontSize="9.5"
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="PrivacyLevelText" Grid.Column="11" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="{StaticResource GoldBrush}" FontSize="10" />
            </Grid>
        </Border>

        <views:PrivacyDockControl x:Name="PrivacyDock" Grid.Row="5" />

        <Popup x:Name="DownloadsPopup" AllowsTransparency="True" IsOpen="False" StaysOpen="True"
               Placement="Bottom" PlacementTarget="{Binding ElementName=DownloadsIndicator}"
               PopupAnimation="Fade">
            <Border x:Name="DownloadsFlyoutRoot" Width="404" MaxHeight="392" Margin="8"
                    Background="{StaticResource OverlayBrush}" CornerRadius="14"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    MouseEnter="DownloadsFlyoutRoot_MouseEnter" MouseLeave="DownloadsFlyoutRoot_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <Grid Margin="14,10,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Загрузки" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="подробности — Ctrl+J" FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="336">
                        <ItemsControl x:Name="DownloadsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:DownloadItem}">
                                    <Border Padding="10,8" Margin="0,2" CornerRadius="10"
                                            Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}"
                                                       FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                            <Button Grid.Row="0" Grid.Column="1" Content="&#xE8E5;"
                                                    Style="{StaticResource IconButton}" FontSize="14" Padding="6,4"
                                                    Margin="2,0" ToolTip="Открыть файл" Tag="{Binding}"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    Click="DownloadsOpenFile_Click" />
                                            <Button Grid.Row="0" Grid.Column="2" Content="&#xE838;"
                                                    Style="{StaticResource IconButton}" FontSize="14" Padding="6,4"
                                                    ToolTip="Показать в папке" Tag="{Binding}"
                                                    Foreground="{StaticResource GoldBrush}"
                                                    Click="DownloadsShowFolder_Click" />

                                            <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                         Height="3" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                                         Value="{Binding Progress, Mode=OneWay}"
                                                         Foreground="{StaticResource AccentBrush}"
                                                         Background="{StaticResource BorderBrush}" BorderThickness="0">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Завершено">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Прервано">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                       Text="{Binding ProgressText}" FontSize="10.5" Margin="0,6,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                                       Text="{Binding ScanStateText}" FontSize="10.5" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ScanState}" Value="{x:Static services:DownloadScanState.Clean}">
                                                                <Setter Property="Foreground" Value="#38D996" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ScanState}" Value="{x:Static services:DownloadScanState.Scanning}">
                                                                <Setter Property="Foreground" Value="{StaticResource GoldBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ScanState}" Value="{x:Static services:DownloadScanState.Threat}">
                                                                <Setter Property="Foreground" Value="#E0567A" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>

    </Grid>
