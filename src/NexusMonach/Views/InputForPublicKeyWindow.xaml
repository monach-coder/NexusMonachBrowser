<Window x:Class="NexusMonach.Views.InputForPublicKeyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Публичный ключ собеседника" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="/Assets/nexus-monach.ico" Style="{StaticResource GlassPopupWindow}">
    <StackPanel Margin="18">
        <TextBlock Text="Вставьте публичный ключ собеседника (base64, 64 байта) — на нём будет завёрнут ключ комнаты. Ключ собеседник берёт в своей панели обмена."
                   TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
        <TextBox x:Name="KeyBox" Margin="0,10,0,12" Padding="9,7" FontFamily="Cascadia Mono, Consolas"
                 FontSize="11" TextWrapping="Wrap" MinHeight="70" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Style="{StaticResource NexusButton}" Padding="14,7" Margin="0,0,10,0"
                    IsCancel="True" />
            <Button Content="Создать инвайт" Style="{StaticResource NexusButton}" Padding="14,7"
                    IsDefault="True" Click="Accept_Click" />
        </StackPanel>
    </StackPanel>
</Window>
