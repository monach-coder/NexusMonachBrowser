<Window x:Class="NexusMonach.Views.NetworkWatchdogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сетевой Дозор · активная защита" Width="720" Height="520"
        MinWidth="640" MinHeight="400" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="/Assets/nexus-monach.ico" Style="{StaticResource GlassPopupWindow}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Сетевой Дозор" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Активный мониторинг и противодействие: honeypot ловит сканеров, обманщик путает отпечатки, страж блокирует атаки."
                       TextWrapping="Wrap" Margin="0,5,0,12" FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SettingsCard}" Grid.Column="0" Margin="0,0,8,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Ловушки" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="HoneypotCount" Text="7" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="портов-приманок" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}" Grid.Column="1" Margin="0,0,8,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Атаки" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="ThreatCount" Text="0" FontSize="20" FontWeight="SemiBold"
                               Foreground="#FF6B6B" />
                    <TextBlock Text="обнаружено" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}" Grid.Column="2" Margin="0,0,8,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Заблокировано" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="BlockedCount" Text="0" FontSize="20" FontWeight="SemiBold"
                               Foreground="#FFB86C" />
                    <TextBlock Text="источников" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}" Grid.Column="3" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="Статус" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock x:Name="WatchdogStatus" Text="Активен" FontSize="20" FontWeight="SemiBold"
                               Foreground="#50D890" />
                    <TextBlock Text="защита работает" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource SettingsCard}" Padding="0">
            <ListView x:Name="ThreatLog" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Время" Width="70"
                                        DisplayMemberBinding="{Binding DetectedAt, StringFormat=HH:mm:ss}" />
                        <GridViewColumn Header="Тип" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Type}" Foreground="#FFB86C" FontWeight="SemiBold" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Источник" Width="120"
                                        DisplayMemberBinding="{Binding Source}" />
                        <GridViewColumn Header="Детали" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Details}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Details}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Ответ" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Countermeasure}" Foreground="#50D890"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0"
                    HorizontalAlignment="Right">
            <Button Content="Разблокировать все" Style="{StaticResource NexusButton}"
                    Padding="14,7" Margin="0,0,12,0" Click="UnblockAll_Click" />
            <Button Content="Закрыть" Style="{StaticResource NexusButton}"
                    Padding="14,7" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
