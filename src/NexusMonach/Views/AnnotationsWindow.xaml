<Window x:Class="NexusMonach.Views.AnnotationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заметки и фрагменты" Width="760" Height="560" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="/Assets/nexus-monach.ico" Style="{StaticResource GlassPopupWindow}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Заметки и фрагменты" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Подсветки, заметки и видео-фрагменты страниц — дерево по сайтам. Экспорт — Markdown с сохранением структуры."
                       Margin="0,4,0,10" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>

        <ListBox x:Name="ItemsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,8,8" Padding="12" CornerRadius="10"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding SiteHeader}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding PageHeader}" FontSize="11" Margin="0,2,0,6"
                                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                            <Border Width="46" Height="4" HorizontalAlignment="Left" CornerRadius="2" Margin="0,0,0,6"
                                    Background="{Binding ColorBrush}" Visibility="{Binding ColorVisible}" />
                            <TextBlock Text="{Binding Quote}" FontSize="12.5" TextWrapping="Wrap" />
                            <TextBox Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     FontSize="12" Margin="0,6,0,0" Padding="7,5"
                                     TextWrapping="Wrap" MinHeight="0"
                                     Visibility="{Binding NoteBoxVisible}"
                                     LostFocus="NoteBox_LostFocus" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Stamp}" FontSize="10.5"
                                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                <Button Content="Открыть фрагмент" Margin="12,0,0,0" Padding="10,4" FontSize="11"
                                        Style="{StaticResource NexusButton}" Click="OpenMedia_Click"
                                        Visibility="{Binding MediaVisible}" />
                                <Button Content="Удалить" Margin="8,0,0,0" Padding="10,4" FontSize="11"
                                        Style="{StaticResource NexusButton}" Click="Remove_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
            <Button Content="Экспорт в Markdown…" Style="{StaticResource NexusButton}" Padding="16,8"
                    Margin="0,0,10,0" Click="Export_Click" />
            <Button Content="Закрыть" Style="{StaticResource NexusButton}" Padding="16,8"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
