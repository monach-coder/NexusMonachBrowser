<Window x:Class="NexusMonach.Views.ThemeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Первый запуск · оформление" Width="720" Height="590"
        MinWidth="680" MinHeight="480" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        Icon="/Assets/nexus-monach.ico" Style="{StaticResource GlassPopupWindow}">
    <Window.Resources>
        <Style x:Key="ThemeChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceCard" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                                <Border x:Name="SelectionRing" Width="24" Height="24"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,-5,-5,0" CornerRadius="12"
                                        Background="{DynamicResource BackgroundBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="2">
                                    <Ellipse x:Name="SelectionDot" Width="10" Height="10"
                                             Fill="{DynamicResource AccentBrush}"
                                             Visibility="Collapsed" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceCard" Property="Background"
                                        Value="{DynamicResource PanelHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceCard" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ChoiceCard" Property="BorderThickness" Value="3" />
                                <Setter TargetName="SelectionDot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ChoiceCard" Property="BorderBrush"
                                        Value="{DynamicResource GoldBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ContinueButton" TargetType="Button" BasedOn="{StaticResource NexusButton}">
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Выберите оформление Nexus Monach" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Светлый или тёмный режим меняет всё окружение; цвет задаёт фирменный акцент."
                       Margin="0,5,0,10" Foreground="{StaticResource MutedTextBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <RadioButton x:Name="DarkModeChoice" GroupName="Mode" Content="Тёмный режим"
                             IsChecked="True" Margin="0,0,24,0" Checked="ModeChoice_Checked" />
                <RadioButton x:Name="LightModeChoice" GroupName="Mode" Content="Светлый режим"
                             Checked="ModeChoice_Checked" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <RadioButton x:Name="AquaChoice" Grid.Row="0" Grid.Column="0"
                         Style="{StaticResource ThemeChoice}" Tag="MonachAqua" Checked="ThemeChoice_Checked">
                <StackPanel>
                    <Border Height="42" CornerRadius="8" Background="#0B1018"
                            BorderBrush="#36D7C4" BorderThickness="3" />
                    <TextBlock Text="Monach Aqua" Margin="0,10,0,0" FontWeight="SemiBold" />
                    <TextBlock Text="Фирменная бирюза" Foreground="#91A2B4" FontSize="11" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="OceanChoice" Grid.Row="0" Grid.Column="1"
                         Style="{StaticResource ThemeChoice}" Tag="Ocean" Checked="ThemeChoice_Checked">
                <StackPanel>
                    <Border Height="42" CornerRadius="8" Background="#09111D"
                            BorderBrush="#4BB7FF" BorderThickness="3" />
                    <TextBlock Text="Ocean" Margin="0,10,0,0" FontWeight="SemiBold" />
                    <TextBlock Text="Глубокий синий" Foreground="#91A8BC" FontSize="11" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="ForestChoice" Grid.Row="1" Grid.Column="0"
                         Style="{StaticResource ThemeChoice}" Tag="Forest" Checked="ThemeChoice_Checked">
                <StackPanel>
                    <Border Height="42" CornerRadius="8" Background="#09140F"
                            BorderBrush="#50D890" BorderThickness="3" />
                    <TextBlock Text="Forest" Margin="0,10,0,0" FontWeight="SemiBold" />
                    <TextBlock Text="Спокойный зелёный" Foreground="#91AA99" FontSize="11" />
                </StackPanel>
            </RadioButton>
            <RadioButton x:Name="AmethystChoice" Grid.Row="1" Grid.Column="1"
                         Style="{StaticResource ThemeChoice}" Tag="Amethyst" Checked="ThemeChoice_Checked">
                <StackPanel>
                    <Border Height="42" CornerRadius="8" Background="#100B18"
                            BorderBrush="#B68CFF" BorderThickness="3" />
                    <TextBlock Text="Amethyst" Margin="0,10,0,0" FontWeight="SemiBold" />
                    <TextBlock Text="Тёмный фиолетовый" Foreground="#AA9AB9" FontSize="11" />
                </StackPanel>
            </RadioButton>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="Голос ассистента" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Выберите голос для озвучки перевода и ответов."
                       Margin="0,4,0,8" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="VoiceKseniyaChoice" GroupName="Voice" Content="Ксения · женский (рекомендуется)"
                             IsChecked="True" Margin="0,0,24,0" FontSize="13" />
                <RadioButton x:Name="VoiceEugeneChoice" GroupName="Voice" Content="Евгений · мужской"
                             FontSize="13" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock Text="Защита при запуске" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Всё это можно изменить в настройках позже."
                       Margin="0,4,0,8" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
            <CheckBox x:Name="ShieldPortCheck" IsChecked="True" Margin="0,0,0,6" FontSize="13"
                      Content="Порт-щит: закрывать утекающие порты (mDNS, SSDP, NetBIOS) на сессию — один запрос прав при запуске" />
            <CheckBox x:Name="ShieldWatchdogCheck" IsChecked="True" Margin="0,0,0,6" FontSize="13"
                      Content="Сетевой Дозор: ловушки для сканеров и ARP-страж, голосовые оповещения об атаках" />
            <CheckBox x:Name="ShieldRelayCheck">
                <TextBlock TextWrapping="Wrap" FontSize="13"
                           Text="Релейный мост: помогать цензурным пользователям (нужен проброс портов 9101–9102 на роутере; провайдер увидит трафик анонимной сети; выходным узлом вы не бываете)" />
            </CheckBox>
        </StackPanel>

        <Button Grid.Row="4" Content="Продолжить" HorizontalAlignment="Right" Margin="0,16,0,0"
                Style="{StaticResource ContinueButton}" Click="Continue_Click" />
    </Grid>
</Window>
