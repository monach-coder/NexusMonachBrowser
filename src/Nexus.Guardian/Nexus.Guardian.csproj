<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NexusMonach</AssemblyName>
    <RootNamespace>Nexus.Guardian</RootNamespace>
    <Version>$(NexusProductVersion)</Version>
    <Product>Nexus Guardian</Product>
    <Description>Проверка целостности и безопасный запуск Nexus Monach.</Description>
    <ApplicationIcon>..\NexusMonach\Assets\nexus-monach.ico</ApplicationIcon>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup Condition="Exists('..\..\security\integrity-public-key.pem')">
    <EmbeddedResource Include="..\..\security\integrity-public-key.pem"
                      LogicalName="Nexus.Guardian.integrity-public-key.pem" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NexusMonach.Security.Tests" />
  </ItemGroup>
  <Target Name="RequireSelfContainedReleasePublish" BeforeTargets="Publish"
          Condition="'$(Configuration)' == 'Release' and ('$(SelfContained)' != 'true' or '$(RuntimeIdentifier)' != 'win-x64')">
    <Error Text="Release builds must be published as self-contained win-x64. Use --runtime win-x64 --self-contained true." />
  </Target>
</Project>
