<Window x:Class="Nexus.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка Nexus Monach" Width="600" Height="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#E60D0D16" />
        <SolidColorBrush x:Key="Panel" Color="#CC12141F" />
        <SolidColorBrush x:Key="Fg" Color="#EEF4F8" />
        <SolidColorBrush x:Key="Muted" Color="#8A94B0" />
        <SolidColorBrush x:Key="Accent" Color="#5B9DFF" />
        <SolidColorBrush x:Key="AccentDim" Color="#243A66" />
    </Window.Resources>

    <Border Background="{StaticResource Bg}" CornerRadius="16" BorderBrush="#2C3350"
            BorderThickness="1" Margin="10" Padding="34,28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Шапка в стиле браузера: круглая эмблема + бренд -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,22">
                <Border Width="56" Height="56" CornerRadius="28"
                        BorderBrush="{StaticResource Accent}" BorderThickness="1.5"
                        Background="#161B2E" Margin="0,0,16,0">
                    <TextBlock Text="N" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="NEXUS MONACH" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource Fg}" />
                    <TextBlock Text="Приватный браузер с локальным AI" FontSize="12"
                               Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Статус и прогресс -->
            <StackPanel Grid.Row="1" Margin="0,0,0,14">
                <TextBlock x:Name="StatusText" Text="Установка для текущего пользователя — без прав администратора"
                           FontSize="14" Foreground="{StaticResource Fg}" Margin="0,0,0,10" TextWrapping="Wrap" />
                <Border Background="{StaticResource AccentDim}" CornerRadius="5" Height="10" ClipToBounds="True">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="5"
                            Background="{StaticResource Accent}" />
                </Border>
                <TextBlock x:Name="DetailText" FontSize="11.5" Foreground="{StaticResource Muted}"
                           Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Журнал: свёрнут по умолчанию, чтобы не шумел -->
            <Grid Grid.Row="2">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PhaseText" FontSize="12" Foreground="{StaticResource Muted}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Text="Ядро (~76 МБ) установится за секунды, затем нейросети (2.1 ГБ) скачаются здесь же — перевод, голос и распознавание готовы сразу." />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" HorizontalAlignment="Center">
                        <TextBox x:Name="InstallDirBox" Width="360" Padding="9,7"
                                 Foreground="{StaticResource Fg}" Background="#161B2E"
                                 BorderBrush="#2C3350" BorderThickness="1"
                                 VerticalContentAlignment="Center" />
                        <Button Content="Обзор…" Width="80" Padding="0,8" Margin="8,0,0,0"
                                Background="Transparent" Foreground="{StaticResource Muted}"
                                BorderBrush="#2C3350" BorderThickness="1" Cursor="Hand"
                                Click="Browse_Click" />
                    </StackPanel>
                    <TextBlock x:Name="DirHintText" FontSize="10.5" Foreground="{StaticResource Muted}"
                               Margin="0,6,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Одна главная кнопка; в фазе AI появляется «Пропустить» -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="SkipButton" Content="Пропустить нейросети" Width="170" Padding="0,10"
                        Background="Transparent" Foreground="{StaticResource Muted}"
                        BorderBrush="#2C3350" BorderThickness="1" Cursor="Hand" Margin="0,0,12,0"
                        Visibility="Collapsed" Click="Skip_Click" />
                <Button x:Name="InstallButton" Content="Установить" Width="230" Padding="0,11"
                        Background="{StaticResource Accent}" Foreground="#0B1020" BorderThickness="0"
                        Cursor="Hand" Click="Install_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
