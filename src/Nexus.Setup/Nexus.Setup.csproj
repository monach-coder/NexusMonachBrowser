<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>NexusMonach-Setup</AssemblyName>
    <RootNamespace>Nexus.Setup</RootNamespace>
    <ApplicationIcon>..\NexusMonach\Assets\nexus-monach.ico</ApplicationIcon>
    <Version>$(NexusProductVersion)</Version>
    <Product>Nexus Monach Setup</Product>
    <!-- One-file self-contained: запускается на чистой Windows без .NET. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ключ доверия = ключ собранного дистрибутива: скрипт релиза кладёт его
         сюда перед сборкой установщика (в git он не попадает). Официальная
         сборка CI оставляет security/-ключ как fallback. -->
    <EmbeddedResource Include="integrity-public-key.pem"
                      Condition="Exists('integrity-public-key.pem')"
                      LogicalName="Nexus.Setup.integrity-public-key.pem" />
    <EmbeddedResource Remove="integrity-public-key.pem"
                      Condition="!Exists('integrity-public-key.pem')" />
    <EmbeddedResource Include="..\..\security\integrity-public-key.pem"
                      Condition="!Exists('integrity-public-key.pem') and Exists('..\..\security\integrity-public-key.pem')"
                      LogicalName="Nexus.Setup.integrity-public-key.pem" />
  </ItemGroup>

</Project>
