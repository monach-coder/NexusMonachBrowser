bin/
obj/
dist/
.guardian-key/
**/integrity-private-key.pem
Data/
*.user
*.suo
*_wpftmp.csproj
.tmp-translation-smoke/

# Веса и нативные runtime публикуются только в проверенном Full Offline release,
# чтобы случайно не принять в git неподтверждённый многосотмегабайтный файл.
src/NexusMonach/AI/**/*.gguf
src/NexusMonach/AI/**/*.bin
src/NexusMonach/AI/**/*.onnx
src/NexusMonach/AI/**/*.exe
src/NexusMonach/AI/voice/
src/NexusMonach/AI/models/
src/NexusMonach/AI/node_modules/
src/NexusMonach/AI/**/*.dll

# Транспорт VLESS (Xray, MPL-2.0): бинари и гео-базы едут только в
# подписанных релизных паках — в git не принимаются, как и веса моделей.
# Воспроизводимая загрузка: scripts/Get-Xray.ps1
src/NexusMonach/xray/*.exe
src/NexusMonach/xray/*.dat
src/NexusMonach/xray/config.json
src/NexusMonach/xray/*.log

# Сертификаты подписи и приватные ключи никогда не хранятся в Git.
*.pfx
*.p12
*.snk
*.key
.mimosa/
src/Nexus.Setup/integrity-public-key.pem
